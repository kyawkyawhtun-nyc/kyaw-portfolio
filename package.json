{
  "name": "kyaw-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Static personal portfolio for a data analyst.",
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:images": "node scripts/check-images.mjs",
    "test:security": "node scripts/test-security.mjs",
    "hooks:install": "git config core.hooksPath scripts/hooks && chmod +x scripts/hooks/pre-commit scripts/hooks/pre-push"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "7.0.2"
  }
}
