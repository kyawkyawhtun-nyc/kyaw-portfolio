---
import type { CollectionEntry } from 'astro:content';
import { siteHref } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const HeadingTag = headingLevel;
---

<a class="project-card" href={siteHref(`projects/${project.id}/`)}>
  <div class="project-card__meta">
    {project.data.badge ? <span class="badge">{project.data.badge}</span> : null}
    <span class="tool-list">{project.data.meta}</span>
  </div>
  <HeadingTag class="project-card__title">{project.data.title}</HeadingTag>
  <p class="project-card__summary">{project.data.summary}</p>
  <div class="project-card__metrics">
    {
      project.data.cardMetrics.map((metric) => (
        <div>
          <span class="metric__value">{metric.value}</span>
          <span class="metric__label">{metric.label}</span>
        </div>
      ))
    }
  </div>
  <span class="project-card__cta">Read the case study →</span>
</a>
