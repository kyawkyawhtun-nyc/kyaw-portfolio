---
interface Props {
  idPrefix?: string;
}

const { idPrefix = 'retail-monthly' } = Astro.props;
const titleId = `${idPrefix}-title`;
const descId = `${idPrefix}-desc`;

interface MonthPoint {
  month: string;
  revenue: number | null;
  label: string;
  status: 'default' | 'peak' | 'partial';
}

const months: MonthPoint[] = [
  { month: "Dec '10", revenue: 746_724, label: '£0.75M', status: 'default' },
  { month: 'Jan', revenue: 558_449, label: '£0.56M', status: 'default' },
  { month: 'Feb', revenue: 497_026, label: '£0.50M', status: 'default' },
  { month: 'Mar', revenue: 682_014, label: '£0.68M', status: 'default' },
  { month: 'Apr', revenue: 492_368, label: '£0.49M', status: 'default' },
  { month: 'May', revenue: 722_094, label: '£0.72M', status: 'default' },
  { month: 'Jun', revenue: 689_977, label: '£0.69M', status: 'default' },
  { month: 'Jul', revenue: 680_157, label: '£0.68M', status: 'default' },
  { month: 'Aug', revenue: 703_511, label: '£0.70M', status: 'default' },
  { month: 'Sep', revenue: 1_017_597, label: '£1.02M', status: 'default' },
  { month: 'Oct', revenue: 1_069_368, label: '£1.07M', status: 'default' },
  { month: 'Nov', revenue: 1_456_146, label: '£1.46M', status: 'peak' },
  { month: "Dec '11", revenue: 432_701, label: '£0.43M', status: 'partial' },
];

const width = 640;
const height = 320;
const padLeft = 52;
const padRight = 16;
const padTop = 56;
const padBottom = 44;
const plotWidth = width - padLeft - padRight; // 572
const plotHeight = height - padTop - padBottom; // 220
const yBottom = padTop + plotHeight; // 276
const yMax = 1_600_000;

const ticks = [
  { value: 0, label: '£0' },
  { value: 400_000, label: '£0.4M' },
  { value: 800_000, label: '£0.8M' },
  { value: 1_200_000, label: '£1.2M' },
  { value: 1_600_000, label: '£1.6M' },
];

const slotWidth = plotWidth / months.length; // 44
const barWidth = 30;
const barOffset = (slotWidth - barWidth) / 2; // 7

const yFor = (val: number) => Number((yBottom - (val / yMax) * plotHeight).toFixed(1));
const hFor = (val: number) => Number(((val / yMax) * plotHeight).toFixed(1));
---

<figure class="chart-figure">
  <figcaption class="chart-header">
    <span class="chart-kicker">Seasonality</span>
    <p class="chart-title">Monthly net revenue (£), Dec 2010 – Dec 2011</p>
    <p class="chart-subtitle">
      £9,748,131.07 net revenue across 19,960 orders. The Christmas ramp starts in September; December 2011 covers 9 days only.
    </p>
  </figcaption>

  <div class="chart-legend" aria-hidden="true">
    <span class="chart-legend__item">
      <span class="chart-legend__swatch chart-legend__swatch--accent"></span>
      Peak month (Nov 2011 · £1.46M)
    </span>
    <span class="chart-legend__item">
      <span class="chart-legend__swatch chart-legend__swatch--default"></span>
      Monthly net revenue
    </span>
    <span class="chart-legend__item">
      <span class="chart-legend__swatch chart-legend__swatch--missing"></span>
      Partial month (Dec 2011 · 9 days)
    </span>
  </div>

  <div class="chart-canvas" tabindex="0" role="region" aria-label="Monthly retail revenue chart">
    <svg
      class="chart-svg"
      viewBox={`0 0 ${width} ${height}`}
      width="100%"
      role="img"
      aria-labelledby={`${titleId} ${descId}`}
    >
      <title id={titleId}>Monthly net revenue for the UK online retailer, December 2010 to December 2011</title>
      <desc id={descId}>
        Vertical bar chart of monthly net revenue in pounds: December 2010 £746,724, January 2011 £558,449, February £497,026, March £682,014, April £492,368, May £722,094, June £689,977, July £680,157, August £703,511, September £1,017,597, October £1,069,368, November peak £1,456,146, December 2011 £432,701 covering 9 days only.
      </desc>

      {
        ticks.map((tick) => {
          const y = yFor(tick.value);
          return (
            <g>
              <line
                class={tick.value === 0 ? 'chart-axis-line' : 'chart-grid-line'}
                x1={padLeft}
                y1={y}
                x2={width - padRight}
                y2={y}
              />
              <text
                class="chart-axis-label-end"
                x={padLeft - 8}
                y={y + 4}
                text-anchor="end"
              >
                {tick.label}
              </text>
            </g>
          );
        })
      }

      {
        months.map((item, i) => {
          const x = padLeft + i * slotWidth + barOffset;
          const cx = padLeft + i * slotWidth + slotWidth / 2;

          if (item.status === 'partial' || item.revenue === null) {
            const barY = yFor(item.revenue ?? 0);
            const barH = hFor(item.revenue ?? 0);
            return (
              <g>
                <rect
                  class="chart-bar-missing"
                  x={x}
                  y={barY}
                  width={barWidth}
                  height={barH}
                  rx="2"
                />
                <text
                  class="chart-callout-warm"
                  x={cx}
                  y={barY - 22}
                  text-anchor="middle"
                >
                  Partial
                </text>
                <text
                  class="chart-callout-sub"
                  x={cx}
                  y={barY - 9}
                  text-anchor="middle"
                >
                  9 days
                </text>
                <text
                  class="chart-axis-label chart-axis-label-warm"
                  x={cx}
                  y={yBottom + 18}
                  text-anchor="middle"
                >
                  {item.month}
                </text>
              </g>
            );
          }

          const barY = yFor(item.revenue);
          const barH = hFor(item.revenue);
          const isPeak = item.status === 'peak';

          return (
            <g>
              <rect
                class={isPeak ? 'chart-bar-accent' : 'chart-bar-default'}
                x={x}
                y={barY}
                width={barWidth}
                height={barH}
                rx="2"
              />
              {isPeak ? (
                <>
                  <text
                    class="chart-callout-accent"
                    x={cx}
                    y={barY - 22}
                    text-anchor="middle"
                  >
                    PEAK
                  </text>
                  <text
                    class="chart-value-accent"
                    x={cx}
                    y={barY - 8}
                    text-anchor="middle"
                  >
                    {item.label}
                  </text>
                </>
              ) : (
                <text
                  class="chart-value-label"
                  x={cx}
                  y={barY - 7}
                  text-anchor="middle"
                >
                  {item.label}
                </text>
              )}
              <text
                class={isPeak ? 'chart-axis-label chart-axis-label-accent' : 'chart-axis-label'}
                x={cx}
                y={yBottom + 18}
                text-anchor="middle"
              >
                {item.month}
              </text>
            </g>
          );
        })
      }

      <text
        class="chart-axis-unit"
        x={padLeft + plotWidth / 2}
        y={height - 4}
        text-anchor="middle"
      >
        Month · Net revenue = gross sales + returns
      </text>
    </svg>
  </div>

  <p class="chart-source">
    Source: UCI Online Retail dataset (541,909 lines cleaned to 536,641 in BigQuery SQL).
  </p>
</figure>
