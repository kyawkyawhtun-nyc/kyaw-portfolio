#!/bin/sh
# Until this repository is public, gitleaks must run before every push.
# Blocks the push when gitleaks is missing or reports a finding.
# Install with: npm run hooks:install
# Do not bypass this hook with git push --no-verify.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed. Install gitleaks 8.30.1 or newer before pushing. Push blocked." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
saw_ref=0
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  saw_ref=1
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="${remote_sha}..${local_sha}"
  fi
  echo "pre-push: gitleaks git --redact --log-opts=\"$range\" ($local_ref -> $remote_ref)" >&2
  # </dev/null so gitleaks cannot consume the remaining ref lines on stdin.
  if ! gitleaks git --redact --no-banner --verbose --log-opts="$range" </dev/null; then
    echo "pre-push: gitleaks found a secret in the commits being pushed. Push blocked." >&2
    status=1
  fi
done

if [ "$saw_ref" -eq 0 ]; then
  echo "pre-push: no ref lines on stdin; scanning the latest commit." >&2
  if ! gitleaks git --redact --no-banner --verbose --log-opts="-1" </dev/null; then
    echo "pre-push: gitleaks found a secret. Push blocked." >&2
    status=1
  fi
fi

exit "$status"
